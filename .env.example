# AIGameWorld-Studio 环境变量 / Environment Variables

# ===== AIGameWorld Backend 路径 / Backend Paths =====
# SQLite 数据库路径 / SQLite database path
AW_DB_PATH=../AIGameWorld/backend/data/world_state.db

# ChromaDB 实例路径 / ChromaDB instance path
AW_CHROMA_PATH=../AIGameWorld/backend/data/chroma/

# ===== 默认输出 / Default Output =====
# generate 命令的默认输出目录 / Default output directory for generate command
AW_DEFAULT_OUTPUT=./output

# ===== LLM（Phase 3）/ LLM Phase 3 =====
# LLM API 配置（Phase 3 AI 推导模式用）
# LLM_API_KEY=<your-api-key>
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
