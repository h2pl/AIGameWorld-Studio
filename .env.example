# AIGameWorld Studio 环境变量 / Environment Variables
# 复制为 .env 并填入实际值 / Copy to .env and fill in values

# Provider 选择（不设置则使用 config.yaml 中的 llm_provider）/ Provider selection
# STUDIO_LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=sk-your-key-here

# GLM 智谱
# GLM_API_KEY=your-glm-key-here

# Zen Proxy（本地代理，无需 key）
# STUDIO_LLM_PROVIDER=zen-proxy
